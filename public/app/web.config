<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <!-- El APK se sirve por PHP (GET /app/descargar) — aquí solo el default
             document para que el listado de carpeta no dé 403. -->
        <defaultDocument>
            <files>
                <clear/>
                <add value="index.html"/>
            </files>
        </defaultDocument>
    </system.webServer>
</configuration>
