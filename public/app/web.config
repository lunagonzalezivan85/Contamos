<?xml version="1.0" encoding="UTF-8"?>
<!-- Permite que la app del gestor (WebView de Capacitor) consulte
     version.json desde otro origen y sin caché del IIS. -->
<configuration>
    <system.webServer>
        <httpProtocol>
            <customHeaders>
                <add name="Access-Control-Allow-Origin" value="*" />
                <add name="Cache-Control" value="no-store" />
            </customHeaders>
        </httpProtocol>
    </system.webServer>
</configuration>
